# 微信开放平台网站应用。配好后重新部署即可启用扫码登录。
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 授权回调域名必须已在微信开放平台登记，且与这里完全一致。
WECHAT_REDIRECT_URI=https://whatab.com/wechat/callback

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=homepage

# 阿里云 OSS。用户上传的背景图放在桶内 whatab/ 目录。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION_ID=
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ENDPOINT=
ALIYUN_OSS_DOMAIN=

# 会员一年 5 元。变量名与记词云编辑器支付一致。私钥不要提交。
# 不填 WECHAT_PAY_APP_ID 时使用上面的 WECHAT_APP_ID，且该应用必须已绑定商户号。
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_KEY=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
